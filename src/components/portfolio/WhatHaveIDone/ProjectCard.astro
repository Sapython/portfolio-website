---
const { projectName, description, techIcons, route, size = 'medium', position = 'middle', metrics = [] } = Astro.props;
---
<script lang="ts">
    if (!customElements.get('project-card')) {
        class ProjectCard extends HTMLElement{
            constructor(){
                super();
            }
        }

        customElements.define('project-card', ProjectCard);
    }
</script>
<style lang="scss">
    .cascadiyaFont{
        font-family: 'CascadiyaCode';
    }
    project-card{
        $primary: #BB7A4F;
        $contrast:#161616;
        display: flex;
        flex-direction: column;
        gap:25px;
        background:$contrast;
        box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000,35%);
        border-radius: 0;
        padding: 25px;
        width: 100%;
        height: 100%;
        min-height: 300px;
        box-sizing: border-box;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;

        &::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, $primary 0%, transparent 50%);
            border-radius: inherit;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 0;
        }

        // Position-based border radius - Desktop (default: 50px)
        &.pos-top-left {
            border-radius: 50px 0 0 0;
        }

        &.pos-top-right {
            border-radius: 0 50px 0 0;
        }

        &.pos-bottom-left {
            border-radius: 0 0 0 50px;
        }

        &.pos-bottom-right {
            border-radius: 0 0 50px 0;
        }

        &.pos-middle-right {
            border-radius: 0 10px 10px 0;
        }

        &.pos-middle-left {
            border-radius: 10px 0 0 10px;
        }

        &.pos-middle {
            border-radius: 0;
        }

        // Tablet/smaller desktop responsive border radius (1200-1600px: 40px)
        @media screen and (max-width: 1600px) {
            &.pos-top-left {
                border-radius: 40px 0 0 0;
            }

            &.pos-top-right {
                border-radius: 0 40px 0 0;
            }

            &.pos-bottom-left {
                border-radius: 0 0 0 40px;
            }

            &.pos-bottom-right {
                border-radius: 0 0 40px 0;
            }

            &.pos-middle-right {
                border-radius: 0 8px 8px 0;
            }

            &.pos-middle-left {
                border-radius: 8px 0 0 8px;
            }
        }

        // Tablet responsive border radius (850-1200px: 35px)
        @media screen and (max-width: 1200px) {
            &.pos-top-left {
                border-radius: 35px 0 0 0;
            }

            &.pos-top-right {
                border-radius: 0 35px 0 0;
            }

            &.pos-bottom-left {
                border-radius: 0 0 0 35px;
            }

            &.pos-bottom-right {
                border-radius: 0 0 35px 0;
            }

            &.pos-middle-right {
                border-radius: 0 7px 7px 0;
            }

            &.pos-middle-left {
                border-radius: 7px 0 0 7px;
            }
        }

        &:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: inset 0 3px 15px #47372D, 0 30px 60px rgba(#000000, 45%);

            &::before {
                opacity: 0.12;
            }
        }

        & > *{
            margin: 0;
            position: relative;
            z-index: 1;
        }

        // Size variations
        &.size-hero {
            min-height: 500px;
            padding: 35px;
            gap: 25px;

            h3 {
                font-size: 35px !important;
            }

            p {
                font-size: 18px !important;
                line-height: 1.6;
            }

            .icons i {
                font-size: 32px !important;
            }

            .metricsGrid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: 12px;

                .metricCard {
                    background: rgba($primary, 0.08);
                    border: 1px solid rgba($primary, 0.2);
                    border-radius: 15px;
                    padding: 15px 18px;
                    display: flex;
                    flex-direction: column;
                    gap: 6px;
                    transition: all 0.3s ease;

                    &:hover {
                        background: rgba($primary, 0.12);
                        border-color: rgba($primary, 0.35);
                        transform: translateY(-3px);
                    }

                    .metricValue {
                        @extend .cascadiyaFont;
                        font-size: 28px;
                        font-weight: 700;
                        color: $primary;
                        line-height: 1;
                    }

                    .metricLabel {
                        @extend .cascadiyaFont;
                        font-size: 12px;
                        color: #7a7d7d;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        line-height: 1.3;
                    }
                }
            }

        }

        &.size-large {
            min-height: 400px;

            h3 {
                font-size: 28px !important;
            }

            p {
                font-size: 17px !important;
            }
        }

        &.size-medium {
            min-height: 350px;
        }

        &.size-small {
            min-height: 300px;
            padding: 20px;
            gap: 18px;

            h3 {
                font-size: 20px !important;
            }

            p {
                font-size: 14px !important;
            }

            .icons i {
                font-size: 20px !important;
            }
        }
        h3{
            @extend .cascadiyaFont;
            font-size: 25px;
            color:var(--primary-color);
            margin-top: 20px;
        }
        p{
            @extend .cascadiyaFont;
            font-size: 16px;
            font-weight: 500;
            color:var(--primary-color);
        }
        .icons{
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            align-items: center;
            gap:20px;
            i{
                font-size: 25px;
                color:var(--primary-color);
                transition: all 0.3s ease;
            }
        }

        &:hover .icons i {
            color: $primary;
        }
        .actions{
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap:20px;
            margin-top: auto;
            a{
                text-decoration: none;
            }
            button{
                cursor: pointer;
                transition: all 0.2s ease;
                @extend .cascadiyaFont;
                background: $primary;
                border: none;
                padding: 8px 16px;
                border-radius: 6px;
                color: $contrast;
                font-weight: 500;
                font-size: 13px;
                box-shadow: 0 2px 0 darken($primary, 15%),
                            0 3px 8px rgba(#000000, 0.3);

                &:hover{
                    transform: translateY(-1px);
                    box-shadow: 0 3px 0 darken($primary, 15%),
                                0 4px 10px rgba(#000000, 0.35);
                }

                &:active {
                    transform: translateY(1px);
                    box-shadow: 0 1px 0 darken($primary, 15%),
                                0 2px 4px rgba(#000000, 0.25);
                }
            }
        }
        @media screen and (max-width: 850px) {
            min-height: 280px;

            // Reset all border radius for mobile stacking
            &.pos-top-left,
            &.pos-top-right,
            &.pos-middle-right,
            &.pos-middle-left,
            &.pos-middle,
            &.pos-bottom-left {
                border-radius: 0;
            }

            // Only keep top corners rounded on first card (30px for mobile)
            &.pos-top-left {
                border-radius: 30px 30px 0 0;
            }

            // Only keep bottom corners rounded on last card (30px for mobile)
            &.pos-bottom-right {
                border-radius: 0 0 30px 30px;
            }

            &.size-hero {
                min-height: 350px;
                padding: 25px;

                h3 {
                    font-size: 28px !important;
                }

                p {
                    font-size: 16px !important;
                }

                .metricsGrid {
                    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                    gap: 10px;

                    .metricCard {
                        padding: 12px 15px;

                        .metricValue {
                            font-size: 24px;
                        }

                        .metricLabel {
                            font-size: 11px;
                        }
                    }
                }
            }

            &.size-large {
                min-height: 320px;

                h3 {
                    font-size: 24px !important;
                }
            }

        }

        @media screen and (max-width: 600px) {
            min-height: 250px;
            padding: 20px;
            gap: 18px;

            // Smaller border radius for small mobile (25px)
            &.pos-top-left {
                border-radius: 25px 25px 0 0;
            }

            &.pos-bottom-right {
                border-radius: 0 0 25px 25px;
            }

            h3 {
                font-size: 22px !important;
            }

            p {
                font-size: 15px !important;
            }

            &.size-hero {
                min-height: 300px;

                h3 {
                    font-size: 24px !important;
                }

                p {
                    font-size: 15px !important;
                }

                .icons i {
                    font-size: 24px !important;
                }

                .metricsGrid {
                    grid-template-columns: repeat(2, 1fr);
                    gap: 8px;

                    .metricCard {
                        padding: 10px 12px;

                        .metricValue {
                            font-size: 20px;
                        }

                        .metricLabel {
                            font-size: 10px;
                        }
                    }
                }
            }

            &.size-small {
                h3 {
                    font-size: 18px !important;
                }

                p {
                    font-size: 13px !important;
                }
            }

        }

        // Extra small mobile (20px border radius for very small screens)
        @media screen and (max-width: 400px) {
            &.pos-top-left {
                border-radius: 20px 20px 0 0;
            }

            &.pos-bottom-right {
                border-radius: 0 0 20px 20px;
            }
        }
    }
</style>
<project-card class={`size-${size} pos-${position}`}>
    <h3>{projectName && projectName}</h3>
    <p>{description && description}</p>
    <div class="icons">
        {techIcons && techIcons.map((icon:string) => <i class={icon} />)}
    </div>
    {metrics && metrics.length > 0 && (
        <div class="metricsGrid">
            {metrics.map((metric: any) => (
                <div class="metricCard">
                    <span class="metricValue">{metric.value}</span>
                    <span class="metricLabel">{metric.label}</span>
                </div>
            ))}
        </div>
    )}
    <div class="actions">
        <a href={`/${route}`}>
            <button>View Details</button>
        </a>
    </div>
</project-card>