---
import CompanyCard from "./CompanyCard.astro";
import "../portfolio.scss"
import swayambhuImage from "../../../assets/images/swayambhu.png";
import shreevaImage from "../../../assets/images/shreeva.png";
---

<section class="detail row innerPadding">
    <div class="content">
        <h2>Whom i have worked with</h2>
        <p>My professional journey across innovative companies, from payment solutions to e-commerce platforms.</p>
        <br>
    </div>
    <div class="companies">
        <CompanyCard title="Shiphouse Ecommerce" startYear="2025" endYear="2026"></CompanyCard>
        <CompanyCard title="Govindam" flipped={true} startYear="2024" endYear="2025"></CompanyCard>
        <CompanyCard title="Shreeva Soft-Tech" image={shreevaImage} startYear="2022" endYear="2023"></CompanyCard>
        <CompanyCard title="Swayambhu Innovations" flipped={true} image={swayambhuImage} startYear="2020" endYear="2022"></CompanyCard>
    </div>
</section>