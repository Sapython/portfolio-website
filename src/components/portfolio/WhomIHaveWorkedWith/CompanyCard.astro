---
import { Image } from "astro:assets";
const { image, startYear, endYear, title, flipped } = Astro.props;
---
<style lang="scss">
    company-card{
        background-image:url('/company.svg');
        background-repeat:no-repeat;
        background-size: 130%;
        background-position:center;
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        padding:30px;
        width:300px;
        height:300px;
        z-index: 2;
        gap:13px;
        filter: drop-shadow(0px 0px 10px rgba(0,0,0,0.45));
        transition:.5s;
        &:hover{
            filter: drop-shadow(0px 0px 20px rgba(0,0,0,0.75));
        }
        &.flipped{
            transform:rotateZ(180deg);
            >*{
                transform:rotateZ(-180deg);
            }
        }
        >*{
            margin: 0;
            color:var(--primary-color);
            font-family: 'CascadiyaCode';
        }
        img, .placeholder-icon{
            margin-top: 40px;
            width: 30%;
        }
        .placeholder-icon{
            display: flex;
            align-items: center;
            justify-content: center;
        }
        p{
            text-transform: capitalize;
        }
        @media screen and (max-width: 500px){
            width: 150px;
            height: 150px;
            img, .placeholder-icon{
                width: 40%;
            }
        }
    }
</style>
<script lang="ts">
    if (!customElements.get('company-card')) {
        class CompanyCard extends HTMLElement{
            constructor(){
                super();
            }
        }

        customElements.define('company-card', CompanyCard);
    }
</script>

<company-card class={flipped && 'flipped'}>
    {image && <Image src={image} alt={title}></Image>}
    {!image && <div class="placeholder-icon">
        <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="60" height="60" rx="10" fill="#bb7a4f" opacity="0.2"/>
            <text x="30" y="38" text-anchor="middle" fill="#bb7a4f" font-size="24" font-family="CascadiyaCode">{title.substring(0, 2).toUpperCase()}</text>
        </svg>
    </div>}
    <span>{startYear}-{endYear}</span>
    <p>{title}</p>
</company-card>