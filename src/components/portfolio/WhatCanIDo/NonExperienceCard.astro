---
const { class: className, title, experience, projects, deployments, icons, height } = Astro.props;
let canvasHeight = 40;
if (height === 'small') {
    canvasHeight = 35;
} else if (height === 'medium') {
    canvasHeight = 50;
} else if (height === 'large') {
    canvasHeight = 60;
} else {
    canvasHeight = 50;
}
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .cascadiyaFont {
        font-family: 'CascadiyaCode';
    }

    non-experience-card.experience {
        border-radius: 0;
        background: $contrast;
        box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;

        &::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, $primary 0%, transparent 50%);
            border-radius: inherit;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 0;
            pointer-events: none;
        }

        &:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: inset 0 3px 15px #47372D, 0 30px 60px rgba(#000000, 45%);
            cursor: pointer;

            &::before {
                opacity: 0.12;
            }

            .content .icons i {
                color: $primary;
            }
        }

        .content {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 28px;
            position: relative;
            z-index: 1;

            & > * {
                margin: 0;
            }

            h4 {
                @extend .cascadiyaFont;
                color: $primary;
                text-align: left;
                font-size: 26px;
                font-weight: 700;
                margin: 0;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                line-height: 1.1;
            }

            .stats {
                display: flex;
                flex-direction: column;
                gap: 2px;
                margin-top: 0;

                p {
                    @extend .cascadiyaFont;
                    color: #7a7d7d;
                    font-size: 14px;
                    text-align: left;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    line-height: 1.3;

                    &::before {
                        content: '▹';
                        color: $primary;
                        font-size: 16px;
                    }
                }
            }

            .icons {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                align-items: center;
                margin-top: 4px;

                i {
                    color: #5a5d5d;
                    font-size: 22px;
                    transition: all 0.3s ease;
                }
            }
        }

        .canvasWrapper {
            width: 100%;
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        canvas {
            width: 100%;
            display: block;
        }

        &.webDev {
            grid-area: webDev;
            border-radius: 50px 0 0 0;
        }

        &.appDev {
            grid-area: appDev;
            border-radius: 0 50px 50px 0;
        }

        &.tools {
            grid-area: tools;
            border-radius: 0 0 0 50px;
        }

        &.backendDev {
            grid-area: backendDev;
            border-radius: 0;
        }

        @media screen and (max-width: 850px) {
            .content {
                padding: 24px;

                h4 {
                    font-size: 24px;
                }

                .stats p {
                    font-size: 13px;
                }

                .icons i {
                    font-size: 20px;
                }
            }
        }

        @media screen and (max-width: 500px) {
            &.webDev {
                border-radius: 50px 50px 0 0;
            }

            &.appDev,
            &.backendDev {
                border-radius: 0;
            }

            &.tools {
                border-radius: 0 0 50px 50px;
            }

            .content {
                padding: 22px;

                h4 {
                    font-size: 22px;
                }

                .stats p {
                    font-size: 12px;
                }

                .icons i {
                    font-size: 18px;
                }
            }
        }
    }
</style>

<non-experience-card role="link" href="/webdev" class:list={['experience', className]} style={{ '--canvas-height': canvasHeight }} data-canvasHeight={canvasHeight}>
    <div class="content">
        <h4>{title}</h4>
        <div class="stats">
            {experience && <p>{experience} Years Experience</p>}
            {projects && <p>{projects} Production Projects</p>}
            {deployments && <p>{deployments} Active Deployments</p>}
        </div>
        <div class="icons">
            {icons && icons.map((icon: any) => <i class={icon}></i>)}
        </div>
    </div>
    <div class="canvasWrapper">
        <canvas></canvas>
    </div>
</non-experience-card>

<svg width="0" height="0">
    <filter id="strong-inner">
        <feFlood flood-color="rgba(0,0,0,94%)" />
        <feComposite operator="out" in2="SourceGraphic" />
        <feMorphology operator="dilate" radius="10" />
        <feGaussianBlur stdDeviation="8" />
        <feComposite operator="atop" in2="SourceGraphic" />
    </filter>
</svg>

<script>
    import { interpolate } from "flubber";
    import { generateRandomWave } from './waves';

    if (!customElements.get('non-experience-card')) {
        class NonExperienceCard extends HTMLElement {
        delayValue: number;
        ctx: CanvasRenderingContext2D | null = null;
        currentPath: string = '';
        animationFrameId: number | null = null;
        waveAnimationFrameId: number | null = null;
        lastAnimationTime: number = 0;
        DURATION: number;
        NUMBER_OF_POINTS: number = 10;
        MINIMUM_FREQUENCY: number = 10;
        MAXIMUM_FREQUENCY: number = 30;
        isVisible: boolean = false;
        isAnimating: boolean = false;
        observer: IntersectionObserver | null = null;
        prefersReducedMotion: boolean = false;

        constructor() {
            super();
            this.delayValue = Math.floor(Math.random() * 3001);
            this.dataset.canvasheight = window.innerWidth < 500 ? "35" : "50";
            this.DURATION = 2000;
            this.addEventListener('click', this.handleClick.bind(this));

            // Check for reduced motion preference
            this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        connectedCallback() {
            this.initCanvas();
            this.setupIntersectionObserver();
        }

        setupIntersectionObserver() {
            // Only animate when card is in viewport with 100px margin
            const options = {
                root: null,
                rootMargin: '100px',
                threshold: 0.1
            };

            this.observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    this.isVisible = entry.isIntersecting;

                    if (entry.isIntersecting && !this.prefersReducedMotion) {
                        // Card is visible, start animation
                        if (!this.isAnimating) {
                            this.startAnimation();
                        }
                    } else {
                        // Card is not visible, stop animation
                        this.stopAnimation();
                    }
                });
            }, options);

            this.observer.observe(this);
        }

        initCanvas() {
            const canvas = this.querySelector(".canvasWrapper canvas") as HTMLCanvasElement;
            if (canvas) {
                canvas.width = this.offsetWidth;
                canvas.height = Number(this.dataset.canvasheight);
                this.ctx = canvas.getContext("2d", {
                    alpha: true,
                    desynchronized: true // Better performance for animations
                });
                if (this.ctx) {
                    this.ctx.strokeStyle = getComputedStyle(this).getPropertyValue('--primary-color');
                    this.ctx.lineWidth = 2;
                    this.currentPath = generateRandomWave(this.NUMBER_OF_POINTS, this.MINIMUM_FREQUENCY, this.MAXIMUM_FREQUENCY, Number(this.dataset.canvasheight), canvas.width);
                    this.drawPath(this.currentPath);
                }
            }
        }

        startAnimation() {
            if (this.isAnimating) return;

            this.isAnimating = true;
            this.DURATION = Math.floor(Math.random() * (5000 - 3000 + 1) + 3000);
            this.lastAnimationTime = performance.now();
            this.animationLoop(this.lastAnimationTime);
        }

        stopAnimation() {
            this.isAnimating = false;

            if (this.animationFrameId) {
                cancelAnimationFrame(this.animationFrameId);
                this.animationFrameId = null;
            }

            if (this.waveAnimationFrameId) {
                cancelAnimationFrame(this.waveAnimationFrameId);
                this.waveAnimationFrameId = null;
            }
        }

        animationLoop(timestamp: number) {
            if (!this.isAnimating || !this.isVisible) {
                this.animationFrameId = null;
                return;
            }

            const elapsed = timestamp - this.lastAnimationTime;

            if (elapsed >= this.DURATION) {
                this.animateWave();
                this.lastAnimationTime = timestamp;
            }

            this.animationFrameId = requestAnimationFrame(this.animationLoop.bind(this));
        }

        animateWave() {
            if (!this.isVisible || !this.isAnimating) return;

            const DURATION_RANGE = [3000, 5000];
            const changeDuration = Math.floor(Math.random() * (DURATION_RANGE[1] - DURATION_RANGE[0] + 1) + DURATION_RANGE[0]);
            const newPath = generateRandomWave(this.NUMBER_OF_POINTS, this.MINIMUM_FREQUENCY, this.MAXIMUM_FREQUENCY, Number(this.dataset.canvasheight), this.ctx?.canvas.width || 1000);

            const interpolatePaths = interpolate(this.currentPath, newPath, { maxSegmentLength: 10 });

            const startTime = performance.now();
            const durationMs = changeDuration;

            const animateFrame = (timestamp: number) => {
                if (!this.ctx || !this.isVisible || !this.isAnimating) {
                    this.waveAnimationFrameId = null;
                    return;
                }

                const elapsed = timestamp - startTime;
                const progress = Math.min(elapsed / durationMs, 1);

                // Clear and redraw
                this.ctx.clearRect(0, 0, this.ctx.canvas.width, this.ctx.canvas.height);
                const path = interpolatePaths(progress);
                this.drawPath(path);

                if (progress < 1) {
                    this.waveAnimationFrameId = requestAnimationFrame(animateFrame);
                } else {
                    this.waveAnimationFrameId = null;
                }
            };

            // Cancel any existing wave animation before starting new one
            if (this.waveAnimationFrameId) {
                cancelAnimationFrame(this.waveAnimationFrameId);
            }

            this.waveAnimationFrameId = requestAnimationFrame(animateFrame);

            this.currentPath = newPath;
            this.DURATION = changeDuration;
        }

        drawPath(d: string) {
            if (this.ctx) {
                const path = new Path2D(d);
                this.ctx.save();
                this.ctx.fillStyle = getComputedStyle(this).getPropertyValue('--primary-color');
                this.ctx.filter = 'url(#strong-inner)';
                this.ctx.fill(path);
                this.ctx.stroke(path);
                this.ctx.restore();
            }
        }

        disconnectedCallback() {
            // Clean up observer
            if (this.observer) {
                this.observer.disconnect();
                this.observer = null;
            }

            // Clean up animations
            this.stopAnimation();
        }

        handleClick() {
            const link = this.getAttribute('href');
            if (link) {
                window.location.href = link;
            }
        }
    }

        // Register the custom element
        customElements.define('non-experience-card', NonExperienceCard);
    }
</script>
