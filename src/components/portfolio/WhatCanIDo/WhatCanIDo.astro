---
import ExperienceCard from "./ExperienceCard.astro";
import NonExperienceCard from "./NonExperienceCard.astro";
let webDevIcons = [
    'devicon-typescript-plain',
    'devicon-angularjs-plain',
    'devicon-react-original',
    'devicon-ionic-original',
    'devicon-firebase-plain',
    'devicon-sass-original',
    'devicon-tailwindcss-plain',
];

let appDevIcons = [
'devicon-typescript-plain',
    'devicon-angularjs-plain',
    'devicon-react-original',
    'devicon-ionic-original',
    'devicon-firebase-plain',
    'devicon-androidstudio-plain',
    'devicon-java-plain',
    'devicon-kotlin-plain'
]

let serverIcons = [
    'devicon-python-plain',
    'go-original-wordmark',
    'devicon-typescript-plain',
    'devicon-graphql-plain',
    'devicon-googlecloud-plain',
    'devicon-docker-plain'
]

let devOpsIcons = [
    'devicon-docker-plain',
    'devicon-jenkins-plain',
    'devicon-jira-plain',
    'devicon-terraform-plain',
    'devicon-github-original',
]
import "../portfolio.scss";

---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .knowMoreBtn {
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: 'CascadiyaCode', monospace;
        background: $primary;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        color: $contrast;
        font-weight: 500;
        font-size: 13px;
        box-shadow: 0 2px 0 darken($primary, 15%),
                    0 3px 8px rgba(#000000, 0.3);

        &:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 0 darken($primary, 15%),
                        0 4px 10px rgba(#000000, 0.35);
        }

        &:active {
            transform: translateY(1px);
            box-shadow: 0 1px 0 darken($primary, 15%),
                        0 2px 4px rgba(#000000, 0.25);
        }
    }
</style>

<section class="detail two-col">
    <div class="content">
        <h2>What can I Do</h2>
        <p>Well, I am a Full Stack Developer</p>
        <br>
        <p>My experience has been quite varied throughout my coding journey. Take a look at any one of them. (Or just scroll)</p>
        <button class="knowMoreBtn">
            Know More
        </button>
    </div>
    <div class="experiences">
        <NonExperienceCard height="medium" class="webDev" title="Web Dev" experience="6" projects="46" icons={webDevIcons}></NonExperienceCard>
        <NonExperienceCard height="large" class="appDev" title="App Dev" experience="4" projects="12" deployments="4" icons={appDevIcons}></NonExperienceCard>
        <NonExperienceCard height="small" class="backendDev" title="Server" projects="2" icons={serverIcons}></NonExperienceCard>
        <NonExperienceCard height="small" class="tools" experience="3" title="Dev Ops" icons={devOpsIcons}></NonExperienceCard>
    </div>
    <!-- <div class="experiences">
        <ExperienceCard height="medium" class="webDev" title="Web Dev" experience="6" projects="46" icons={webDevIcons}></ExperienceCard>
        <ExperienceCard height="large" class="appDev" title="App Dev" experience="4" projects="12" deployments="4" icons={appDevIcons}></ExperienceCard>
        <ExperienceCard height="small" class="backendDev" title="Server" projects="2" icons={serverIcons}></ExperienceCard>
        <ExperienceCard height="small" class="tools" experience="3" title="Dev Ops" icons={devOpsIcons}></ExperienceCard>
    </div> -->
</section>