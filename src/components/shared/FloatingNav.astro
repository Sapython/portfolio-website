<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .floatingNav {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(150%);
        z-index: 1000;
        background: $contrast;
        box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 45%);
        border-radius: 50px;
        padding: 12px 20px;
        display: flex;
        gap: 8px;
        align-items: center;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
        opacity: 0;
        pointer-events: none;

        &.visible {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
            pointer-events: all;
        }

        .navLink {
            font-family: 'CascadiyaCode', monospace;
            color: #7a7d7d;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;

            &::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba($primary, 0.15) 0%, rgba($primary, 0.05) 100%);
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            &:hover {
                color: $primary;
                background: rgba($primary, 0.1);

                &::before {
                    opacity: 1;
                }
            }

            &.active {
                color: $contrast;
                background: $primary;
                box-shadow: 0 2px 0 darken($primary, 15%),
                            0 3px 8px rgba(#000000, 0.3);

                &:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 3px 0 darken($primary, 15%),
                                0 4px 10px rgba(#000000, 0.35);
                }

                &:active {
                    transform: translateY(1px);
                    box-shadow: 0 1px 0 darken($primary, 15%),
                                0 2px 4px rgba(#000000, 0.25);
                }
            }
        }

        @media screen and (max-width: 600px) {
            bottom: 20px;
            padding: 10px 15px;
            gap: 6px;

            .navLink {
                padding: 8px 14px;
                font-size: 12px;
            }
        }

        @media screen and (max-width: 500px) {
            bottom: 15px;
            padding: 8px 12px;
            gap: 4px;

            .navLink {
                padding: 7px 12px;
                font-size: 11px;
            }
        }
    }
</style>

<nav class="floatingNav" id="floatingNav">
    <a href="/blog" class="navLink">Blog</a>
    <a href="/projects" class="navLink">Projects</a>
    <a href="/newsletter" class="navLink">Newsletter</a>
    <a href="/contact" class="navLink">Contact</a>
</nav>

<script>
    const floatingNav = document.getElementById('floatingNav');
    const whatCanIDoSection = document.querySelector('.two-col');

    let isVisible = false;

    function checkScroll() {
        if (!whatCanIDoSection || !floatingNav) return;

        const sectionTop = whatCanIDoSection.getBoundingClientRect().top;
        const windowHeight = window.innerHeight;

        // Show nav when "What Can I Do" section is in viewport
        const shouldShow = sectionTop < windowHeight * 0.8;

        if (shouldShow && !isVisible) {
            floatingNav.classList.add('visible');
            isVisible = true;
        } else if (!shouldShow && isVisible) {
            floatingNav.classList.remove('visible');
            isVisible = false;
        }
    }

    // Highlight active link based on current page
    function setActiveLink() {
        const currentPath = window.location.pathname;
        const links = floatingNav?.querySelectorAll('.navLink');

        links?.forEach(link => {
            const href = link.getAttribute('href');
            if (currentPath === href || (currentPath === '/' && href === '/')) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    }

    // Throttle scroll event
    let ticking = false;
    window.addEventListener('scroll', () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                checkScroll();
                ticking = false;
            });
            ticking = true;
        }
    });

    // Initial check
    checkScroll();
    setActiveLink();
</script>
