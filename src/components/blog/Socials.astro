---
interface Props{
    links:{
        icon:string;
        path:string;
    }[]
}
export interface SocialMediaPostProps extends Props{}
const  { links } = Astro.props;
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .icons {
        display: flex;
        gap: 8px;

        a {
            width: 32px;
            height: 32px;
            background: rgba($primary, 0.1);
            display: grid;
            place-items: center;
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba($primary, 0.2);

            i {
                font-size: 16px;
                color: $primary;
                transition: transform 0.3s ease;
            }

            &:hover {
                background: rgba($primary, 0.2);
                transform: translateY(-2px);

                i {
                    transform: scale(1.1);
                }
            }
        }
    }
</style>
<div class="icons">
    {links.map((link)=>(
        <a href={link.path}>
            <i class={link.icon}></i>
        </a>
    ))}
</div>