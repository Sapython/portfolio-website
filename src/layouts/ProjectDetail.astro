---
import Layout from './Layout.astro';
import type { ProjectData } from '../data/projects';

interface Props extends ProjectData {}

const {
    title,
    subtitle,
    description,
    techStack,
    highlights,
    challenges,
    outcomes,
    timeline,
    role,
    company,
    slug
} = Astro.props;

// Create inline schema
const projectSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": title,
    "description": description,
    "author": {
        "@type": "Person",
        "name": "Kumar Saptam",
        "url": "https://sapython.me"
    },
    "dateCreated": timeline?.split(' - ')[0],
    "dateModified": timeline?.split(' - ')[1],
    "keywords": techStack?.join(', '),
    "url": `https://sapython.me/project/${slug}`,
    "headline": subtitle,
    "creator": {
        "@type": "Person",
        "name": "Kumar Saptam",
        "jobTitle": role
    },
    "publisher": company ? {
        "@type": "Organization",
        "name": company
    } : undefined
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sapython.me"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Projects",
            "item": "https://sapython.me/#projects"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": title,
            "item": `https://sapython.me/project/${slug}`
        }
    ]
};
---

<style lang="scss">
.projectDetail {
    min-height: 100vh;
    background: var(--background-color);
    padding: 120px 120px 80px;

    @media screen and (max-width: 850px) {
        padding: 100px 80px 60px;
    }

    @media screen and (max-width: 600px) {
        padding: 80px 40px 40px;
    }

    @media screen and (max-width: 500px) {
        padding: 80px 20px 40px;
    }

    .backButton {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'CascadiyaCode', monospace;
        color: #bb7a4f;
        text-decoration: none;
        margin-bottom: 40px;
        font-size: 16px;
        transition: gap 0.3s ease;

        &:hover {
            gap: 15px;
        }

        &::before {
            content: '←';
            font-size: 20px;
        }
    }

    .projectHeader {
        margin-bottom: 60px;

        .meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 20px;
            font-family: 'CascadiyaCode', monospace;
            font-size: 14px;
            color: #5a5d5d;

            .metaItem {
                display: flex;
                align-items: center;
                gap: 8px;

                .label {
                    color: #bb7a4f;
                }
            }
        }

        h1 {
            font-family: 'RustyCage';
            font-size: 60px;
            color: var(--primary-color);
            margin-bottom: 15px;
            line-height: 1.2;

            @media screen and (max-width: 600px) {
                font-size: 40px;
            }
        }

        .subtitle {
            font-family: 'CascadiyaCode', monospace;
            font-size: 24px;
            color: #bb7a4f;
            margin-bottom: 20px;

            @media screen and (max-width: 600px) {
                font-size: 18px;
            }
        }

        .description {
            font-family: 'CascadiyaCode', monospace;
            font-size: 18px;
            color: var(--primary-color);
            line-height: 1.6;
            max-width: 900px;
        }
    }

    .techStack {
        margin-bottom: 50px;

        h2 {
            font-family: 'CascadiyaCode', monospace;
            font-size: 28px;
            color: #bb7a4f;
            margin-bottom: 20px;
        }

        .techList {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;

            .techItem {
                background: linear-gradient(135deg, #1e2726 0%, #1a1e1d 100%);
                border: 1px solid #2a3332;
                border-radius: 8px;
                padding: 10px 18px;
                font-family: 'CascadiyaCode', monospace;
                font-size: 14px;
                color: var(--primary-color);
                transition: all 0.3s ease;

                &:hover {
                    border-color: #bb7a4f;
                    transform: translateY(-2px);
                }
            }
        }
    }

    .section {
        margin-bottom: 50px;

        h2 {
            font-family: 'CascadiyaCode', monospace;
            font-size: 28px;
            color: #bb7a4f;
            margin-bottom: 20px;
        }

        ul {
            list-style: none;
            padding: 0;

            li {
                font-family: 'CascadiyaCode', monospace;
                font-size: 16px;
                color: var(--primary-color);
                line-height: 1.6;
                margin-bottom: 15px;
                padding-left: 30px;
                position: relative;

                &::before {
                    content: '▹';
                    position: absolute;
                    left: 0;
                    color: #bb7a4f;
                    font-size: 20px;
                }
            }
        }
    }
}
</style>

<Layout title={title}>
    <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <div class="projectDetail">
        <a href="/#projects" class="backButton">Back to Projects</a>

        <div class="projectHeader">
            <div class="meta">
                {timeline && (
                    <div class="metaItem">
                        <span class="label">Timeline:</span>
                        <span>{timeline}</span>
                    </div>
                )}
                {role && (
                    <div class="metaItem">
                        <span class="label">Role:</span>
                        <span>{role}</span>
                    </div>
                )}
                {company && (
                    <div class="metaItem">
                        <span class="label">Company:</span>
                        <span>{company}</span>
                    </div>
                )}
            </div>
            <h1>{title}</h1>
            <div class="subtitle">{subtitle}</div>
            <p class="description">{description}</p>
        </div>

        <div class="techStack">
            <h2>Technology Stack</h2>
            <div class="techList">
                {techStack.map((tech) => (
                    <span class="techItem">{tech}</span>
                ))}
            </div>
        </div>

        <div class="section">
            <h2>Key Highlights</h2>
            <ul>
                {highlights.map((highlight) => (
                    <li>{highlight}</li>
                ))}
            </ul>
        </div>

        {challenges && challenges.length > 0 && (
            <div class="section">
                <h2>Technical Challenges</h2>
                <ul>
                    {challenges.map((challenge) => (
                        <li>{challenge}</li>
                    ))}
                </ul>
            </div>
        )}

        {outcomes && outcomes.length > 0 && (
            <div class="section">
                <h2>Outcomes & Impact</h2>
                <ul>
                    {outcomes.map((outcome) => (
                        <li>{outcome}</li>
                    ))}
                </ul>
            </div>
        )}
    </div>
</Layout>
