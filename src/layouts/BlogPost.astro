---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

type Props = CollectionEntry<'posts'>['data'] & {
    slug?: string;
};

const { title, description, date, author, tags, heroImage, slug } = Astro.props;

// Get all posts for related posts
const allPosts = await getCollection('posts');

// Calculate reading time (rough estimate: 200 words per minute)
const content = await Astro.slots.render('default');
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Get current URL for sharing
const currentUrl = Astro.url.href;

// Format date
const formattedDate = date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

// Get tag data
const tagData = await Promise.all(
    tags.map(async (tag) => {
        const collection = await getCollection('tags');
        return collection.find(t => t.slug === tag.slug);
    })
);
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .blogPostPage {
        background: var(--background-color);
        min-height: 100vh;

        .heroSection {
            width: 100%;
            height: 400px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, $contrast 0%, darken($contrast, 5%) 100%);

            .heroImage {
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0.7;
            }

            .heroOverlay {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 40px 120px;
                background: linear-gradient(to top, rgba($contrast, 0.95) 0%, transparent 100%);

                .breadcrumb {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 13px;
                    margin-bottom: 15px;

                    a {
                        color: $primary;
                        text-decoration: none;
                        transition: color 0.2s ease;

                        &:hover {
                            color: lighten($primary, 10%);
                        }
                    }
                }

                h1 {
                    font-family: 'RustyCage';
                    color: $primary;
                    font-size: 48px;
                    margin: 0 0 15px 0;
                    line-height: 1.2;
                }

                .meta {
                    display: flex;
                    gap: 20px;
                    align-items: center;
                    flex-wrap: wrap;

                    .metaItem {
                        font-family: 'CascadiyaCode';
                        color: #7a7d7d;
                        font-size: 14px;
                        display: flex;
                        align-items: center;
                        gap: 8px;

                        i {
                            color: $primary;
                            font-size: 16px;
                        }
                    }
                }
            }
        }

        .contentWrapper {
            max-width: 1400px;
            margin: 0 auto;
            padding: 60px 120px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 60px;
            align-items: start;

            .mainContent {
                max-width: 750px;
                margin: 0 auto;

                .description {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 18px;
                    line-height: 1.8;
                    margin-bottom: 40px;
                    padding: 30px;
                    background: $contrast;
                    border-left: 4px solid $primary;
                    box-shadow: inset 0 3px 10px #47372D;
                    border-radius: 0 10px 10px 0;
                }

                .prose {

                }

                .shareSection {
                    margin-top: 60px;
                    padding-top: 40px;
                    border-top: 2px solid rgba($primary, 0.2);

                    h3 {
                        font-family: 'CascadiyaCode';
                        color: $primary;
                        font-size: 18px;
                        font-weight: 700;
                        margin: 0 0 20px 0;
                    }

                    .shareButtons {
                        display: flex;
                        gap: 15px;
                        flex-wrap: wrap;

                        a {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            padding: 12px 20px;
                            background: $contrast;
                            border-radius: 10px;
                            text-decoration: none;
                            font-family: 'CascadiyaCode';
                            color: #7a7d7d;
                            font-size: 14px;
                            transition: all 0.3s ease;
                            box-shadow: inset 0 3px 10px #47372D;

                            i {
                                font-size: 18px;
                            }

                            &:hover {
                                color: $primary;
                                transform: translateY(-2px);
                                box-shadow: inset 0 3px 15px #47372D, 0 5px 15px rgba(#000000, 0.3);
                            }

                            &.twitter:hover { color: #1DA1F2; }
                            &.facebook:hover { color: #4267B2; }
                            &.linkedin:hover { color: #0077B5; }
                            &.reddit:hover { color: #FF4500; }
                        }
                    }
                }
            }

            .sidebar {
                position: sticky;
                top: 20px;

                .sidebarCard {
                    background: $contrast;
                    box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                    border-radius: 25px 10px 25px 10px;
                    padding: 25px;
                    margin-bottom: 25px;

                    h3 {
                        font-family: 'CascadiyaCode';
                        color: $primary;
                        font-size: 16px;
                        font-weight: 700;
                        margin: 0 0 15px 0;
                        padding-bottom: 10px;
                        border-bottom: 2px solid rgba($primary, 0.2);
                    }

                    .authorInfo {
                        display: flex;
                        flex-direction: column;
                        gap: 10px;

                        .authorName {
                            font-family: 'CascadiyaCode';
                            color: #d0d0d0;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        .authorBio {
                            font-family: 'CascadiyaCode';
                            color: #7a7d7d;
                            font-size: 13px;
                            line-height: 1.6;
                        }
                    }

                    .tagList {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 8px;

                        a {
                            font-family: 'CascadiyaCode';
                            background: rgba($primary, 0.1);
                            color: $primary;
                            padding: 6px 12px;
                            border-radius: 6px;
                            font-size: 12px;
                            text-decoration: none;
                            border: 1px solid rgba($primary, 0.2);
                            transition: all 0.3s ease;

                            &:hover {
                                background: rgba($primary, 0.2);
                                transform: translateY(-2px);
                            }
                        }
                    }

                    .tocList {
                        list-style: none;
                        padding: 0;
                        margin: 0;

                        li {
                            margin-bottom: 10px;

                            a {
                                font-family: 'CascadiyaCode';
                                color: #7a7d7d;
                                font-size: 13px;
                                text-decoration: none;
                                transition: color 0.2s ease;
                                display: block;
                                padding: 5px 0;

                                &:hover {
                                    color: $primary;
                                }
                            }

                            &.toc-h2 {
                                padding-left: 0;
                            }

                            &.toc-h3 {
                                padding-left: 15px;
                            }
                        }
                    }

                    .quickShare {
                        display: flex;
                        gap: 10px;
                        justify-content: center;

                        a {
                            width: 40px;
                            height: 40px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            background: rgba($primary, 0.1);
                            border-radius: 8px;
                            color: $primary;
                            font-size: 18px;
                            transition: all 0.3s ease;
                            text-decoration: none;

                            &:hover {
                                background: rgba($primary, 0.2);
                                transform: translateY(-2px);
                            }
                        }
                    }
                }
            }
        }

        @media screen and (max-width: 1600px) {
            .heroSection .heroOverlay {
                padding: 40px 80px;
            }

            .contentWrapper {
                padding: 60px 80px;
            }
        }

        @media screen and (max-width: 1200px) {
            .contentWrapper {
                grid-template-columns: 1fr;
                gap: 40px;

                .sidebar {
                    position: relative;
                    top: 0;
                    order: -1;

                    .sidebarCard {
                        margin-bottom: 20px;
                    }
                }
            }
        }

        @media screen and (max-width: 850px) {
            .heroSection {
                height: 300px;

                .heroOverlay {
                    padding: 30px 80px;

                    h1 {
                        font-size: 36px;
                    }
                }
            }

            .contentWrapper {
                padding: 40px 80px;
            }
        }

        @media screen and (max-width: 600px) {
            .heroSection {
                height: 250px;

                .heroOverlay {
                    padding: 20px 40px;
                }
            }

            .contentWrapper {
                padding: 30px 40px;

                .mainContent .description {
                    padding: 20px;
                    font-size: 16px;
                }
            }
        }

        @media screen and (max-width: 500px) {
            .heroSection {
                height: 200px;

                .heroOverlay {
                    padding: 15px 20px;

                    h1 {
                        font-size: 28px;
                    }

                    .meta {
                        gap: 12px;

                        .metaItem {
                            font-size: 12px;
                        }
                    }
                }
            }

            .contentWrapper {
                padding: 25px 20px;

                .mainContent {
                    .description {
                        font-size: 15px;
                        padding: 18px;
                    }
                }

                .sidebar .sidebarCard {
                    padding: 20px;
                }
            }
        }
    }
</style>

<style is:global lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    /* Global styles for blog post content */
    .prose {
        font-family: 'CascadiyaCode';
        color: #d0d0d0;
        font-size: 16px;
        line-height: 1.8;

        h1, h2, h3, h4, h5, h6 {
            font-family: 'CascadiyaCode';
            color: $primary;
            margin-top: 40px;
            margin-bottom: 20px;
            font-weight: 700;
            line-height: 1.3;
        }

        h1 { font-size: 32px; }
        h2 { font-size: 28px; }
        h3 { font-size: 24px; }
        h4 { font-size: 20px; }
        h5 { font-size: 18px; }
        h6 { font-size: 16px; }

        p {
            margin-bottom: 20px;
            color: #d0d0d0;
        }

        a {
            color: $primary;
            text-decoration: underline;
            transition: color 0.2s ease;

            &:hover {
                color: lighten($primary, 10%);
            }
        }

        ul, ol {
            margin-bottom: 20px;
            padding-left: 30px;
            color: #d0d0d0;

            li {
                margin-bottom: 10px;
            }
        }

        blockquote {
            border-left: 4px solid $primary;
            padding-left: 20px;
            margin: 30px 0;
            font-style: italic;
            color: #9a9a9a;

            p {
                color: #9a9a9a;
            }
        }

        code {
            font-family: 'CascadiyaCode';
            background: rgba($primary, 0.1);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 14px;
            color: $primary;
        }

        pre {
            background: $contrast;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
            margin: 30px 0;
            box-shadow: inset 0 3px 10px #47372D;

            code {
                background: none;
                padding: 0;
                color: #d0d0d0;
                font-size: 14px;
            }
        }

        img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin: 30px 0;
            display: block;
        }

        hr {
            border: none;
            border-top: 2px solid rgba($primary, 0.2);
            margin: 40px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 30px 0;
            font-size: 15px;

            th, td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid rgba($primary, 0.2);
            }

            th {
                background: $contrast;
                color: $primary;
                font-weight: 700;
            }

            tr:hover {
                background: rgba($primary, 0.05);
            }
        }

        strong, b {
            font-weight: 700;
            color: lighten(#d0d0d0, 10%);
        }

        em, i {
            font-style: italic;
        }
    }

    /* Mobile responsive styles for prose */
    @media screen and (max-width: 500px) {
        .prose {
            font-size: 15px;

            h1 { font-size: 26px; }
            h2 { font-size: 22px; }
            h3 { font-size: 18px; }
            h4 { font-size: 16px; }
            h5 { font-size: 15px; }
            h6 { font-size: 14px; }

            pre {
                padding: 15px;
                font-size: 13px;
            }

            code {
                font-size: 13px;
            }

            table {
                font-size: 13px;

                th, td {
                    padding: 8px;
                }
            }
        }
    }
</style>

<Layout title={title}>
    <div class="blogPostPage">
        <div class="heroSection">
            {heroImage && (
                <img src={heroImage} alt={title} class="heroImage" />
            )}
            <div class="heroOverlay">
                <div class="breadcrumb">
                    <a href="/">Home</a> / <a href="/blog">Blog</a> / {title}
                </div>
                <h1>{title}</h1>
                <div class="meta">
                    <div class="metaItem">
                        <i class="ri-calendar-line"></i>
                        <span>{formattedDate}</span>
                    </div>
                    <div class="metaItem">
                        <i class="ri-time-line"></i>
                        <span>{readingTime} min read</span>
                    </div>
                    <div class="metaItem">
                        <i class="ri-user-line"></i>
                        <span>{author}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="contentWrapper">
            <div class="mainContent">
                <div class="description">
                    {description}
                </div>

                <div class="prose">
                    <slot />
                </div>

                <div class="shareSection">
                    <h3>Share this article</h3>
                    <div class="shareButtons">
                        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="twitter">
                            <i class="ri-twitter-x-line"></i>
                            <span>Twitter</span>
                        </a>
                        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer" class="facebook">
                            <i class="ri-facebook-line"></i>
                            <span>Facebook</span>
                        </a>
                        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer" class="linkedin">
                            <i class="ri-linkedin-line"></i>
                            <span>LinkedIn</span>
                        </a>
                        <a href={`https://reddit.com/submit?url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="reddit">
                            <i class="ri-reddit-line"></i>
                            <span>Reddit</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="sidebar">
                <div class="sidebarCard">
                    <h3>About Author</h3>
                    <div class="authorInfo">
                        <div class="authorName">{author}</div>
                        <div class="authorBio">
                            Full Stack Engineer with 6+ years of experience building production systems.
                        </div>
                    </div>
                </div>

                <div class="sidebarCard">
                    <h3>Quick Share</h3>
                    <div class="quickShare">
                        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" title="Share on Twitter">
                            <i class="ri-twitter-x-line"></i>
                        </a>
                        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer" title="Share on Facebook">
                            <i class="ri-facebook-line"></i>
                        </a>
                        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer" title="Share on LinkedIn">
                            <i class="ri-linkedin-line"></i>
                        </a>
                        <a href={`https://reddit.com/submit?url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" title="Share on Reddit">
                            <i class="ri-reddit-line"></i>
                        </a>
                    </div>
                </div>

                {tagData && tagData.length > 0 && (
                    <div class="sidebarCard">
                        <h3>Tags</h3>
                        <div class="tagList">
                            {tagData.map(tag => tag && (
                                <a href={`/blog?tag=${tag.slug}`}>
                                    {tag.data.title}
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>
    </div>
</Layout>
