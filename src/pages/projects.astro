---
import Layout from "../layouts/Layout.astro";
import Spacer from "../shared/components/Spacer.astro";
import { projects } from "../data/projects";

// Group projects by company for better organization
const projectsByCompany = [
    {
        company: "Shiphouse Ecommerce",
        period: "2025 - 2026",
        projects: projects.filter(p => p.company === "Shiphouse Ecommerce")
    },
    {
        company: "Govindam",
        period: "2024 - 2025",
        projects: projects.filter(p => p.company === "Govindam")
    },
    {
        company: "Shreeva Soft-Tech Innovations",
        period: "2022 - 2023",
        projects: projects.filter(p => p.company === "Shreeva Soft-Tech Innovations")
    },
    {
        company: "Swayambhu Innovations",
        period: "2020 - 2022",
        projects: projects.filter(p => p.company === "Swayambhu Innovations")
    }
].filter(group => group.projects.length > 0);
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .projectsPage {
        background: var(--background-color);
        min-height: 100vh;
        padding-inline: 120px;
        padding-block: 60px;

        .pageHeader {
            margin-bottom: 60px;

            h1 {
                font-family: 'RustyCage';
                font-weight: 500;
                font-size: 60px;
                color: $primary;
                margin: 0 0 10px 0;
            }

            p {
                font-family: 'CascadiyaCode';
                color: #7a7d7d;
                font-size: 16px;
                margin: 0;
            }
        }

        .companySection {
            margin-bottom: 70px;

            .companyHeader {
                display: flex;
                align-items: baseline;
                gap: 15px;
                margin-bottom: 30px;
                padding-bottom: 15px;
                border-bottom: 2px solid rgba($primary, 0.2);

                h2 {
                    font-family: 'CascadiyaCode';
                    color: $primary;
                    font-size: 24px;
                    font-weight: 700;
                    margin: 0;
                }

                .period {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 14px;
                }
            }

            .projectsGrid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
                gap: 30px;
            }

            .projectCard {
                background: $contrast;
                box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                border-radius: 25px 10px 25px 10px;
                padding: 30px;
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 15px;
                cursor: pointer;
                text-decoration: none;

                &::before {
                    content: '';
                    position: absolute;
                    top: -2px;
                    left: -2px;
                    right: -2px;
                    bottom: -2px;
                    background: linear-gradient(135deg, $primary 0%, transparent 50%);
                    border-radius: inherit;
                    opacity: 0;
                    transition: opacity 0.4s ease;
                    z-index: 0;
                    pointer-events: none;
                }

                &:hover {
                    transform: translateY(-8px) scale(1.02);
                    box-shadow: inset 0 3px 15px #47372D, 0 30px 60px rgba(#000000, 45%);

                    &::before {
                        opacity: 0.12;
                    }

                    .viewButton {
                        transform: translateY(-1px);
                        box-shadow: 0 3px 0 darken($primary, 15%),
                                    0 4px 10px rgba(#000000, 0.35);
                    }
                }

                > * {
                    position: relative;
                    z-index: 1;
                }

                h3 {
                    font-family: 'CascadiyaCode';
                    color: $primary;
                    font-size: 18px;
                    font-weight: 700;
                    margin: 0;
                    line-height: 1.2;
                }

                .subtitle {
                    font-family: 'CascadiyaCode';
                    color: #5a5d5d;
                    font-size: 13px;
                    font-weight: 500;
                    margin: -5px 0 0 0;
                }

                p {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 13px;
                    line-height: 1.6;
                    margin: 0;
                    flex: 1;
                }

                .techStack {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    margin-top: 5px;

                    .tech {
                        font-family: 'CascadiyaCode';
                        background: rgba($primary, 0.1);
                        color: $primary;
                        padding: 4px 10px;
                        border-radius: 4px;
                        font-size: 12px;
                        font-weight: 600;
                        border: 1px solid rgba($primary, 0.2);
                    }
                }

                .cardFooter {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-top: 10px;
                    padding-top: 15px;
                    border-top: 1px solid rgba($primary, 0.1);

                    .role {
                        font-family: 'CascadiyaCode';
                        color: #5a5d5d;
                        font-size: 12px;
                        font-style: italic;
                    }

                    .viewButton {
                        cursor: pointer;
                        transition: all 0.2s ease;
                        font-family: 'CascadiyaCode', monospace;
                        background: $primary;
                        border: none;
                        padding: 8px 16px;
                        border-radius: 6px;
                        color: $contrast;
                        font-weight: 500;
                        font-size: 13px;
                        box-shadow: 0 2px 0 darken($primary, 15%),
                                    0 3px 8px rgba(#000000, 0.3);

                        &:active {
                            transform: translateY(1px);
                            box-shadow: 0 1px 0 darken($primary, 15%),
                                        0 2px 4px rgba(#000000, 0.25);
                        }
                    }
                }
            }
        }

        @media screen and (max-width: 1600px) {
            padding-inline: 80px;
        }

        @media screen and (max-width: 850px) {
            padding-inline: 80px;
            padding-block: 40px;

            .pageHeader {
                margin-bottom: 40px;

                h1 {
                    font-size: 48px;
                }

                p {
                    font-size: 15px;
                }
            }

            .companySection {
                margin-bottom: 50px;

                .companyHeader h2 {
                    font-size: 22px;
                }

                .projectsGrid {
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 25px;
                }
            }
        }

        @media screen and (max-width: 600px) {
            padding-inline: 40px;

            .companySection .projectsGrid {
                grid-template-columns: 1fr;
            }
        }

        @media screen and (max-width: 500px) {
            padding-inline: 20px;
            padding-block: 30px;

            .pageHeader {
                margin-bottom: 30px;

                h1 {
                    font-size: 40px;
                }

                p {
                    font-size: 14px;
                }
            }

            .companySection {
                margin-bottom: 40px;

                .companyHeader {
                    flex-direction: column;
                    gap: 5px;
                    align-items: flex-start;

                    h2 {
                        font-size: 20px;
                    }

                    .period {
                        font-size: 13px;
                    }
                }

                .projectCard {
                    padding: 25px;

                    h3 {
                        font-size: 16px;
                    }

                    .subtitle {
                        font-size: 12px;
                    }

                    p {
                        font-size: 12px;
                    }
                }
            }
        }
    }
</style>

<Layout title="Projects - Kumar Saptam">
    <div class="projectsPage">
        <div class="pageHeader">
            <h1>Projects</h1>
            <p>A showcase of my work across different companies and technologies</p>
        </div>

        {projectsByCompany.map(group => (
            <div class="companySection">
                <div class="companyHeader">
                    <h2>{group.company}</h2>
                    <span class="period">{group.period}</span>
                </div>
                <div class="projectsGrid">
                    {group.projects.map(project => (
                        <a href={`/project/${project.slug}`} class="projectCard">
                            <h3>{project.title}</h3>
                            <p class="subtitle">{project.subtitle}</p>
                            <p>{project.description}</p>
                            <div class="techStack">
                                {project.techStack.slice(0, 5).map(tech => (
                                    <span class="tech">{tech}</span>
                                ))}
                                {project.techStack.length > 5 && (
                                    <span class="tech">+{project.techStack.length - 5} more</span>
                                )}
                            </div>
                            <div class="cardFooter">
                                <span class="role">{project.role}</span>
                                <button class="viewButton">View Details</button>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        ))}
    </div>
</Layout>
