---
import Layout from "../layouts/Layout.astro";
import Spacer from "../shared/components/Spacer.astro";

const topics = [
    {
        title: "Software Engineering",
        description: "Deep dives into system design, architecture patterns, and engineering best practices"
    },
    {
        title: "Full Stack Development",
        description: "Tips and tricks for building scalable web and mobile applications"
    },
    {
        title: "DevOps & Infrastructure",
        description: "Container orchestration, CI/CD pipelines, and cloud architecture"
    },
    {
        title: "Performance Optimization",
        description: "Real-world optimization techniques and performance tuning strategies"
    },
    {
        title: "Tech Stack Reviews",
        description: "Honest reviews of technologies, frameworks, and tools I use in production"
    },
    {
        title: "Career Growth",
        description: "Insights on navigating the tech industry and advancing your career"
    }
];

const benefits = [
    "Weekly insights from 6+ years of production experience",
    "Code examples and architectural patterns from real projects",
    "Early access to new blog posts and tutorials",
    "Exclusive content not available on the blog",
    "No spam, unsubscribe anytime"
];
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .newsletterPage {
        background: var(--background-color);
        min-height: 100vh;
        padding-inline: 120px;
        padding-block: 60px;

        .pageHeader {
            margin-bottom: 60px;

            h1 {
                font-family: 'RustyCage';
                font-weight: 500;
                font-size: 60px;
                color: $primary;
                margin: 0 0 20px 0;
            }

            p {
                font-family: 'CascadiyaCode';
                color: #7a7d7d;
                font-size: 16px;
                line-height: 1.6;
                margin: 0;
            }
        }

        .contentWrapper {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 60px;
            max-width: 1400px;
            align-items: start;

            .contentSection {
                order: 1;
            }

            .subscriptionCard {
                order: 2;
            }
        }

        .subscriptionCard {
            background: $contrast;
            box-shadow: inset 0 3px 10px #47372D, 0 30px 60px rgba(#000000, 40%);
            border-radius: 50px 10px 50px 10px;
            padding: 30px;
            width: 100%;
            max-width: 380px;
            box-sizing: border-box;
            position: sticky;
            top: 100px;
            height: fit-content;

            &::before {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient(135deg, $primary 0%, transparent 50%);
                border-radius: inherit;
                opacity: 0.08;
                z-index: 0;
                pointer-events: none;
            }

            > * {
                position: relative;
                z-index: 1;
            }

            h2 {
                font-family: 'CascadiyaCode';
                color: $primary;
                font-size: 20px;
                font-weight: 700;
                margin: 0 0 8px 0;
                text-align: center;
            }

            .subtitle {
                font-family: 'CascadiyaCode';
                color: #7a7d7d;
                font-size: 13px;
                text-align: center;
                margin: 0 0 25px 0;
            }

            .form {
                display: flex;
                flex-direction: column;
                gap: 18px;

                .inputGroup {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;

                    label {
                        font-family: 'CascadiyaCode';
                        color: $primary;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    input {
                        font-family: 'CascadiyaCode';
                        background: rgba(#000000, 0.3);
                        border: 2px solid rgba($primary, 0.2);
                        border-radius: 10px;
                        padding: 12px 16px;
                        color: #fff;
                        font-size: 14px;
                        width: 100%;
                        box-sizing: border-box;
                        transition: all 0.3s ease;

                        &::placeholder {
                            color: #5a5d5d;
                        }

                        &:focus {
                            outline: none;
                            border-color: $primary;
                            box-shadow: 0 0 0 3px rgba($primary, 0.1);
                        }

                        &:hover {
                            border-color: rgba($primary, 0.4);
                        }
                    }
                }

                .subscribeButton {
                    cursor: pointer;
                    transition: all 0.2s ease;
                    font-family: 'CascadiyaCode', monospace;
                    background: $primary;
                    border: none;
                    padding: 12px 24px;
                    border-radius: 10px;
                    color: $contrast;
                    font-weight: 600;
                    font-size: 14px;
                    box-shadow: 0 3px 0 darken($primary, 15%),
                                0 4px 10px rgba(#000000, 0.3);
                    margin-top: 5px;

                    &:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 5px 0 darken($primary, 15%),
                                    0 6px 15px rgba(#000000, 0.35);
                    }

                    &:active {
                        transform: translateY(1px);
                        box-shadow: 0 2px 0 darken($primary, 15%),
                                    0 3px 6px rgba(#000000, 0.25);
                    }
                }
            }

            .privacy {
                font-family: 'CascadiyaCode';
                color: #5a5d5d;
                font-size: 12px;
                text-align: center;
                margin-top: 20px;
                line-height: 1.4;
            }
        }

        .contentSection {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 50px;

            h2 {
                font-family: 'CascadiyaCode';
                color: $primary;
                font-size: 28px;
                font-weight: 700;
                margin: 0 0 30px 0;
            }

            .section {
                margin-bottom: 0;
            }

            .topicsGrid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
                gap: 20px;

                .topicCard {
                    background: $contrast;
                    box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                    border-radius: 25px 10px 25px 10px;
                    padding: 24px;
                    transition: all 0.3s ease;

                    &:hover {
                        transform: translateY(-5px);
                        box-shadow: inset 0 3px 15px #47372D, 0 25px 50px rgba(#000000, 40%);
                    }

                    h3 {
                        font-family: 'CascadiyaCode';
                        color: $primary;
                        font-size: 16px;
                        font-weight: 700;
                        margin: 0 0 8px 0;
                    }

                    p {
                        font-family: 'CascadiyaCode';
                        color: #7a7d7d;
                        font-size: 13px;
                        line-height: 1.6;
                        margin: 0;
                    }
                }
            }

            .benefitsList {
                background: $contrast;
                box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                border-radius: 25px 10px 25px 10px;
                padding: 30px;
                list-style: none;
                margin: 0;

                li {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 14px;
                    line-height: 1.8;
                    padding-left: 30px;
                    position: relative;
                    margin-bottom: 15px;

                    &:last-child {
                        margin-bottom: 0;
                    }

                    &::before {
                        content: '✓';
                        position: absolute;
                        left: 0;
                        color: $primary;
                        font-size: 18px;
                        font-weight: 700;
                    }
                }
            }
        }

        @media screen and (max-width: 1600px) {
            padding-inline: 80px;
        }

        @media screen and (max-width: 1200px) {
            .contentWrapper {
                grid-template-columns: 1fr;
                gap: 40px;

                .contentSection {
                    order: 2;
                }

                .subscriptionCard {
                    order: 1;
                }
            }

            .subscriptionCard {
                position: relative;
                top: 0;
                max-width: 100%;
                margin: 0 auto;
            }
        }

        @media screen and (max-width: 850px) {
            padding-inline: 80px;
            padding-block: 40px;

            .pageHeader {
                margin-bottom: 40px;

                h1 {
                    font-size: 48px;
                }

                p {
                    font-size: 15px;
                }
            }

            .contentWrapper {
                gap: 40px;
            }

            .subscriptionCard {
                padding: 30px;
            }

            .contentSection {
                gap: 40px;

                h2 {
                    font-size: 24px;
                }

                .topicsGrid {
                    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
                    gap: 18px;
                }
            }
        }

        @media screen and (max-width: 600px) {
            padding-inline: 40px;

            .subscriptionCard {
                max-width: 100%;
                padding: 25px;
            }

            .contentSection .topicsGrid {
                grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
                gap: 15px;
            }
        }

        @media screen and (max-width: 500px) {
            padding-inline: 20px;
            padding-block: 30px;

            .pageHeader {
                margin-bottom: 30px;

                h1 {
                    font-size: 40px;
                }

                p {
                    font-size: 14px;
                }
            }

            .contentWrapper {
                gap: 30px;
            }

            .subscriptionCard {
                padding: 25px 20px;
                max-width: 100%;
                border-radius: 30px 10px 30px 10px;

                h2 {
                    font-size: 18px;
                }

                .subtitle {
                    font-size: 12px;
                }

                .form {
                    gap: 15px;

                    .inputGroup {
                        gap: 6px;

                        input {
                            padding: 10px 14px;
                            font-size: 13px;
                        }
                    }

                    .subscribeButton {
                        padding: 10px 18px;
                        font-size: 13px;
                        box-sizing: border-box;
                        width: 100%;
                    }
                }

                .privacy {
                    font-size: 11px;
                }
            }

            .contentSection {
                gap: 30px;

                h2 {
                    font-size: 22px;
                    margin-bottom: 20px;
                }

                .topicsGrid {
                    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
                }

                .benefitsList {
                    padding: 30px 25px;

                    li {
                        font-size: 13px;
                    }
                }
            }
        }

        @media screen and (max-width: 400px) {
            padding-inline: 15px;

            .subscriptionCard {
                padding: 20px 15px;
                border-radius: 25px 8px 25px 8px;

                h2 {
                    font-size: 16px;
                }

                .form {
                    .inputGroup {
                        input {
                            padding: 9px 12px;
                            font-size: 12px;
                        }

                        label {
                            font-size: 12px;
                        }
                    }

                    .subscribeButton {
                        padding: 9px 16px;
                        font-size: 12px;
                    }
                }
            }
        }
    }
</style>

<Layout title="Newsletter - Kumar Saptam">
    <div class="newsletterPage">
        <div class="pageHeader">
            <h1>Newsletter</h1>
            <p>Join me on a journey through software engineering, full-stack development, and everything in between. Get weekly insights delivered straight to your inbox.</p>
        </div>

        <div class="contentWrapper">
            <div class="contentSection">
                <div class="section">
                    <h2>What You'll Learn</h2>
                    <div class="topicsGrid">
                        {topics.map(topic => (
                            <div class="topicCard">
                                <h3>{topic.title}</h3>
                                <p>{topic.description}</p>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="section">
                    <h2>Why Subscribe?</h2>
                    <ul class="benefitsList">
                        {benefits.map(benefit => (
                            <li>{benefit}</li>
                        ))}
                    </ul>
                </div>
            </div>

            <div class="subscriptionCard">
                <h2>Subscribe Now</h2>
                <p class="subtitle">Get weekly insights from the trenches of production engineering</p>
                <form class="form" action="#" method="POST">
                    <div class="inputGroup">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Your name"
                            required
                        />
                    </div>
                    <div class="inputGroup">
                        <label for="email">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            required
                        />
                    </div>
                    <button type="submit" class="subscribeButton">
                        Subscribe to Newsletter
                    </button>
                </form>
                <p class="privacy">
                    Your privacy matters. I'll never share your email or spam you.
                    Unsubscribe anytime with one click.
                </p>
            </div>
        </div>
    </div>
</Layout>

<script>
    // Simple form handling (you can replace this with your actual newsletter service)
    const form = document.querySelector('.form') as HTMLFormElement;

    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            const name = formData.get('name');
            const email = formData.get('email');

            // TODO: Replace with actual newsletter subscription logic

            // Show success message (you can replace this with a nicer notification)
            alert('Thanks for subscribing! Check your email for confirmation.');
            form.reset();
        });
    }
</script>
