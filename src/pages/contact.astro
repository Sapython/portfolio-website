---
import Layout from "../layouts/Layout.astro";
import Spacer from "../shared/components/Spacer.astro";

const contactMethods = [
    {
        title: "Email",
        value: "kumarsaptam45@gmail.com",
        icon: "ri-mail-line",
        href: "mailto:kumarsaptam45@gmail.com"
    },
    {
        title: "LinkedIn",
        value: "/in/kumarsaptam",
        icon: "ri-linkedin-box-line",
        href: "https://linkedin.com/in/kumarsaptam"
    },
    {
        title: "GitHub",
        value: "@sapython",
        icon: "ri-github-line",
        href: "https://github.com/sapython"
    },
    {
        title: "Location",
        value: "India",
        icon: "ri-map-pin-line",
        href: null
    }
];
---

<style lang="scss">
    $primary: #BB7A4F;
    $contrast: #161616;

    .contactPage {
        background: var(--background-color);
        min-height: 100vh;
        padding-inline: 120px;
        padding-block: 60px;

        .pageHeader {
            margin-bottom: 60px;

            h1 {
                font-family: 'RustyCage';
                font-weight: 500;
                font-size: 60px;
                color: $primary;
                margin: 0 0 20px 0;
            }

            p {
                font-family: 'CascadiyaCode';
                color: #7a7d7d;
                font-size: 16px;
                line-height: 1.6;
                margin: 0;
            }
        }

        .contentGrid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 40px;
            max-width: 1400px;
            margin: 0 auto;

            .contactInfo {
                display: flex;
                flex-direction: column;
                gap: 25px;

                .infoCard {
                    background: $contrast;
                    box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                    border-radius: 25px 10px 25px 10px;
                    padding: 28px;
                    transition: all 0.3s ease;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 20px;
                    cursor: pointer;

                    &:hover {
                        transform: translateY(-5px);
                        box-shadow: inset 0 3px 15px #47372D, 0 25px 50px rgba(#000000, 40%);

                        .icon {
                            background: $primary;
                            color: $contrast;
                            transform: scale(1.1);
                        }
                    }

                    &.no-link {
                        cursor: default;

                        &:hover {
                            transform: none;
                            box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);

                            .icon {
                                transform: none;
                                background: rgba($primary, 0.15);
                                color: $primary;
                            }
                        }
                    }

                    .icon {
                        width: 50px;
                        height: 50px;
                        background: rgba($primary, 0.15);
                        border-radius: 12px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: $primary;
                        font-size: 22px;
                        flex-shrink: 0;
                        transition: all 0.3s ease;
                    }

                    .info {
                        flex: 1;

                        h3 {
                            font-family: 'CascadiyaCode';
                            color: $primary;
                            font-size: 14px;
                            font-weight: 700;
                            margin: 0 0 4px 0;
                        }

                        p {
                            font-family: 'CascadiyaCode';
                            color: #7a7d7d;
                            font-size: 13px;
                            margin: 0;
                        }
                    }
                }

                .availabilityCard {
                    background: $contrast;
                    box-shadow: inset 0 3px 10px #47372D, 0 20px 40px rgba(#000000, 35%);
                    border-radius: 25px 10px 25px 10px;
                    padding: 30px;
                    margin-top: 10px;
                    position: relative;
                    overflow: hidden;

                    &::before {
                        content: '';
                        position: absolute;
                        top: -2px;
                        left: -2px;
                        right: -2px;
                        bottom: -2px;
                        background: linear-gradient(135deg, $primary 0%, transparent 50%);
                        border-radius: inherit;
                        opacity: 0.08;
                        z-index: 0;
                        pointer-events: none;
                    }

                    > * {
                        position: relative;
                        z-index: 1;
                    }

                    h3 {
                        font-family: 'CascadiyaCode';
                        color: $primary;
                        font-size: 15px;
                        font-weight: 700;
                        margin: 0 0 12px 0;
                        display: flex;
                        align-items: center;
                        gap: 10px;

                        &::before {
                            content: '';
                            width: 10px;
                            height: 10px;
                            background: $primary;
                            border-radius: 50%;
                            animation: pulse 2s infinite;
                        }
                    }

                    p {
                        font-family: 'CascadiyaCode';
                        color: #7a7d7d;
                        font-size: 13px;
                        line-height: 1.6;
                        margin: 0;
                    }

                    @keyframes pulse {
                        0%, 100% {
                            opacity: 1;
                            box-shadow: 0 0 0 0 rgba($primary, 0.7);
                        }
                        50% {
                            opacity: 0.7;
                            box-shadow: 0 0 0 8px rgba($primary, 0);
                        }
                    }
                }
            }

            .contactForm {
                background: $contrast;
                box-shadow: inset 0 3px 10px #47372D, 0 30px 60px rgba(#000000, 40%);
                border-radius: 50px 10px 50px 10px;
                padding: 35px;
                position: relative;

                &::before {
                    content: '';
                    position: absolute;
                    top: -2px;
                    left: -2px;
                    right: -2px;
                    bottom: -2px;
                    background: linear-gradient(135deg, $primary 0%, transparent 50%);
                    border-radius: inherit;
                    opacity: 0.08;
                    z-index: 0;
                    pointer-events: none;
                }

                > * {
                    position: relative;
                    z-index: 1;
                }

                h2 {
                    font-family: 'CascadiyaCode';
                    color: $primary;
                    font-size: 20px;
                    font-weight: 700;
                    margin: 0 0 8px 0;
                }

                .subtitle {
                    font-family: 'CascadiyaCode';
                    color: #7a7d7d;
                    font-size: 13px;
                    margin: 0 0 25px 0;
                }

                .form {
                    display: flex;
                    flex-direction: column;
                    gap: 18px;

                    .inputGroup {
                        display: flex;
                        flex-direction: column;
                        gap: 8px;

                        label {
                            font-family: 'CascadiyaCode';
                            color: $primary;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        input, textarea {
                            font-family: 'CascadiyaCode';
                            background: rgba(#000000, 0.3);
                            border: 2px solid rgba($primary, 0.2);
                            border-radius: 10px;
                            padding: 12px 16px;
                            color: #fff;
                            font-size: 14px;
                            transition: all 0.3s ease;
                            resize: vertical;

                            &::placeholder {
                                color: #5a5d5d;
                            }

                            &:focus {
                                outline: none;
                                border-color: $primary;
                                box-shadow: 0 0 0 3px rgba($primary, 0.1);
                            }

                            &:hover {
                                border-color: rgba($primary, 0.4);
                            }
                        }

                        textarea {
                            min-height: 120px;
                        }
                    }

                    .submitButton {
                        cursor: pointer;
                        transition: all 0.2s ease;
                        font-family: 'CascadiyaCode', monospace;
                        background: $primary;
                        border: none;
                        padding: 12px 24px;
                        border-radius: 10px;
                        color: $contrast;
                        font-weight: 600;
                        font-size: 14px;
                        box-shadow: 0 3px 0 darken($primary, 15%),
                                    0 4px 10px rgba(#000000, 0.3);
                        margin-top: 5px;

                        &:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 5px 0 darken($primary, 15%),
                                        0 6px 15px rgba(#000000, 0.35);
                        }

                        &:active {
                            transform: translateY(1px);
                            box-shadow: 0 2px 0 darken($primary, 15%),
                                        0 3px 6px rgba(#000000, 0.25);
                        }
                    }
                }
            }
        }

        @media screen and (max-width: 1600px) {
            padding-inline: 80px;
        }

        @media screen and (max-width: 1200px) {
            .contentGrid {
                grid-template-columns: 1fr;
                gap: 50px;
            }
        }

        @media screen and (max-width: 850px) {
            padding-inline: 80px;
            padding-block: 40px;

            .pageHeader {
                margin-bottom: 40px;

                h1 {
                    font-size: 48px;
                }

                p {
                    font-size: 15px;
                }
            }

            .contentGrid .contactForm {
                padding: 30px;

                h2 {
                    font-size: 18px;
                }
            }
        }

        @media screen and (max-width: 600px) {
            padding-inline: 40px;
        }

        @media screen and (max-width: 500px) {
            padding-inline: 20px;
            padding-block: 30px;

            .pageHeader {
                margin-bottom: 30px;

                h1 {
                    font-size: 40px;
                }

                p {
                    font-size: 14px;
                }
            }

            .contentGrid {
                gap: 30px;

                .contactInfo .infoCard {
                    padding: 22px;

                    .icon {
                        width: 45px;
                        height: 45px;
                        font-size: 20px;
                    }

                    .info h3 {
                        font-size: 13px;
                    }

                    .info p {
                        font-size: 12px;
                    }
                }

                .contactForm {
                    padding: 25px 20px;

                    h2 {
                        font-size: 18px;
                    }

                    .subtitle {
                        font-size: 12px;
                    }

                    .form {
                        gap: 15px;

                        .inputGroup {
                            gap: 6px;
                        }

                        .submitButton {
                            padding: 10px 18px;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
    }
</style>

<Layout title="Contact - Kumar Saptam">
    <div class="contactPage">
        <div class="pageHeader">
            <h1>Get In Touch</h1>
            <p>Have a project in mind or want to discuss opportunities? I'd love to hear from you. Drop me a message and I'll get back to you as soon as possible.</p>
        </div>

        <div class="contentGrid">
            <div class="contactInfo">
                {contactMethods.map(method => (
                    method.href ? (
                        <a href={method.href} class="infoCard" target="_blank" rel="noopener noreferrer">
                            <div class="icon">
                                <i class={method.icon}></i>
                            </div>
                            <div class="info">
                                <h3>{method.title}</h3>
                                <p>{method.value}</p>
                            </div>
                        </a>
                    ) : (
                        <div class="infoCard no-link">
                            <div class="icon">
                                <i class={method.icon}></i>
                            </div>
                            <div class="info">
                                <h3>{method.title}</h3>
                                <p>{method.value}</p>
                            </div>
                        </div>
                    )
                ))}

                <div class="availabilityCard">
                    <h3>Currently Available</h3>
                    <p>I'm open to full-time opportunities, consulting projects, and interesting collaborations. Feel free to reach out to discuss how we can work together.</p>
                </div>
            </div>

            <div class="contactForm">
                <h2>Send a Message</h2>
                <p class="subtitle">Fill out the form below and I'll respond within 24-48 hours</p>
                <form class="form" action="#" method="POST">
                    <div class="inputGroup">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Your name"
                            required
                        />
                    </div>
                    <div class="inputGroup">
                        <label for="email">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            required
                        />
                    </div>
                    <div class="inputGroup">
                        <label for="subject">Subject</label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="What's this about?"
                            required
                        />
                    </div>
                    <div class="inputGroup">
                        <label for="message">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            placeholder="Tell me more about your project or inquiry..."
                            required
                        ></textarea>
                    </div>
                    <button type="submit" class="submitButton">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</Layout>

<script>
    // Simple form handling (you can replace this with your actual contact form service)
    const form = document.querySelector('.form') as HTMLFormElement;

    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            const data = {
                name: formData.get('name'),
                email: formData.get('email'),
                subject: formData.get('subject'),
                message: formData.get('message')
            };

            // TODO: Replace with actual form submission logic (e.g., send to API endpoint)

            // Show success message (you can replace this with a nicer notification)
            alert('Thanks for reaching out! I\'ll get back to you soon.');
            form.reset();
        });
    }
</script>
